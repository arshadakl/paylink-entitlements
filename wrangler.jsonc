{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paylink-entitlements",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paylink-entitlements-db",
      "database_id": "local-db-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GRANT_QUEUE",
        "queue": "drive-access-grants"
      }
    ],
    "consumers": [
      {
        "queue": "drive-access-grants",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "drive-access-grants-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
